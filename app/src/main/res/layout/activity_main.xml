<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rescue_background"
    tools:context=".activities.MainActivity">

    <io.github.sceneview.SceneView
        android:id="@+id/sceneView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/top_scrim_height"
        android:background="@drawable/bg_top_scrim" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_margin"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="@dimen/screen_margin"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dashboard_eyebrow"
            android:textAppearance="@style/TextAppearance.ResQLink.HeroEyebrow"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/dashboard_title"
            android:textAppearance="@style/TextAppearance.ResQLink.HeroTitle" />

    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/panelInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginStart="@dimen/screen_margin"
        android:layout_marginEnd="@dimen/screen_margin"
        android:layout_marginBottom="@dimen/screen_margin"
        app:behavior_hideable="false"
        app:cardBackgroundColor="@color/rescue_surface"
        app:cardCornerRadius="@dimen/panel_corner_radius"
        app:cardElevation="10dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
        app:strokeColor="@color/rescue_outline"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/panelHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/section_spacing"
                android:paddingTop="10dp"
                android:paddingEnd="@dimen/section_spacing"
                android:paddingBottom="6dp">

                <View
                    android:layout_width="44dp"
                    android:layout_height="5dp"
                    android:layout_gravity="center_vertical"
                    android:background="@drawable/bg_panel_handle" />

                <TextView
                    android:id="@+id/tvPanelTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="@string/panel_navigation_controls"
                    android:textAppearance="@style/TextAppearance.ResQLink.SectionTitle" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTogglePanel"
                    style="@style/Widget.ResQLink.Button.Outlined"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:minWidth="0dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="@string/panel_expand"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/panelStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/section_spacing"
                android:paddingEnd="@dimen/section_spacing"
                android:paddingBottom="4dp">

                <TextView
                    android:id="@+id/tvRouteStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/route_idle"
                    android:textAppearance="@style/TextAppearance.ResQLink.SectionTitle"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvTurnInstruction"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/turn_instruction_placeholder"
                    android:textColor="@color/rescue_text_secondary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvDetectedRoom"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_status_chip"
                    android:paddingStart="10dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="4dp"
                    android:text="@string/detected_room_unknown"
                    android:textColor="@color/rescue_text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/panelPrimaryControls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="@dimen/section_spacing"
                android:paddingEnd="@dimen/section_spacing"
                android:paddingBottom="10dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFindPath"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="@string/btn_find_path"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnNextTurn"
                    style="@style/Widget.ResQLink.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="@string/btn_next_turn"
                    android:textSize="13sp" />
            </LinearLayout>

            <androidx.core.widget.NestedScrollView
                android:id="@+id/panelScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:fillViewport="true"
                android:paddingStart="@dimen/section_spacing"
                android:paddingEnd="@dimen/section_spacing"
                android:paddingBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Route Planning -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardBackgroundColor="@color/rescue_surface_alt"
                        app:cardCornerRadius="@dimen/card_corner_radius"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/rescue_outline"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/section_route_planning"
                                android:textAppearance="@style/TextAppearance.ResQLink.SectionTitle" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:text="@string/label_start_location"
                                android:textColor="@color/rescue_text_secondary"
                                android:textSize="13sp" />

                            <androidx.appcompat.widget.AppCompatSpinner
                                android:id="@+id/spinnerStart"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:background="@drawable/bg_spinner_field"
                                android:popupBackground="@color/rescue_surface" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:text="@string/label_destination_location"
                                android:textColor="@color/rescue_text_secondary"
                                android:textSize="13sp" />

                            <androidx.appcompat.widget.AppCompatSpinner
                                android:id="@+id/spinnerDestination"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:background="@drawable/bg_spinner_field"
                                android:popupBackground="@color/rescue_surface" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Victim Signals -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        app:cardBackgroundColor="@color/rescue_surface_alt"
                        app:cardCornerRadius="@dimen/card_corner_radius"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/rescue_outline"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/section_victim_signals"
                                android:textAppearance="@style/TextAppearance.ResQLink.SectionTitle" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:text="@string/broadcast_location_label"
                                android:textColor="@color/rescue_text_secondary"
                                android:textSize="13sp" />

                            <androidx.appcompat.widget.AppCompatSpinner
                                android:id="@+id/spinnerVictimLocation"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:background="@drawable/bg_spinner_field"
                                android:popupBackground="@color/rescue_surface" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:text="@string/victims_nearby"
                                android:textColor="@color/rescue_text_secondary"
                                android:textSize="13sp" />

                            <androidx.appcompat.widget.AppCompatSpinner
                                android:id="@+id/spinnerVictims"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:background="@drawable/bg_spinner_field"
                                android:popupBackground="@color/rescue_surface" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnNavigateVictim"
                                style="@style/Widget.ResQLink.Button.Accent"
                                android:layout_width="match_parent"
                                android:layout_height="44dp"
                                android:layout_marginTop="10dp"
                                android:text="@string/navigate_to_victim"
                                android:textSize="13sp" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:orientation="horizontal">

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnStartBleScan"
                                    style="@style/Widget.ResQLink.Button.Outlined"
                                    android:layout_width="0dp"
                                    android:layout_height="44dp"
                                    android:layout_weight="1"
                                    android:text="@string/start_ble_scan"
                                    android:textSize="12sp" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnBroadcastVictim"
                                    style="@style/Widget.ResQLink.Button.Outlined"
                                    android:layout_width="0dp"
                                    android:layout_height="44dp"
                                    android:layout_marginStart="8dp"
                                    android:layout_weight="1"
                                    android:text="@string/start_victim_broadcast"
                                    android:textSize="12sp" />
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Hazard Marking -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        app:cardBackgroundColor="@color/rescue_surface_alt"
                        app:cardCornerRadius="@dimen/card_corner_radius"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/rescue_outline"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/section_hazard_marking"
                                android:textAppearance="@style/TextAppearance.ResQLink.SectionTitle" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:text="@string/label_hazard_node"
                                android:textColor="@color/rescue_text_secondary"
                                android:textSize="13sp" />

                            <androidx.appcompat.widget.AppCompatSpinner
                                android:id="@+id/spinnerHazardNode"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:background="@drawable/bg_spinner_field"
                                android:popupBackground="@color/rescue_surface" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:text="@string/label_hazard_type"
                                android:textColor="@color/rescue_text_secondary"
                                android:textSize="13sp" />

                            <androidx.appcompat.widget.AppCompatSpinner
                                android:id="@+id/spinnerHazardType"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:background="@drawable/bg_spinner_field"
                                android:popupBackground="@color/rescue_surface" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:orientation="horizontal">

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnPlaceHazard"
                                    style="@style/Widget.ResQLink.Button.Alert"
                                    android:layout_width="0dp"
                                    android:layout_height="44dp"
                                    android:layout_weight="1"
                                    android:text="@string/btn_place_hazard"
                                    android:textSize="13sp" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnRemoveHazard"
                                    style="@style/Widget.ResQLink.Button.Outlined"
                                    android:layout_width="0dp"
                                    android:layout_height="44dp"
                                    android:layout_marginStart="8dp"
                                    android:layout_weight="1"
                                    android:text="@string/btn_remove_hazard"
                                    android:textSize="13sp" />
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Asset Configuration -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        app:cardBackgroundColor="@color/rescue_surface_alt"
                        app:cardCornerRadius="@dimen/card_corner_radius"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/rescue_outline"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/section_assets"
                                android:textAppearance="@style/TextAppearance.ResQLink.SectionTitle" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnToggleGraphDebug"
                                style="@style/Widget.ResQLink.Button.Outlined"
                                android:layout_width="wrap_content"
                                android:layout_height="40dp"
                                android:layout_marginTop="10dp"
                                android:text="@string/show_graph_debug"
                                android:textSize="12sp" />

                            <com.google.android.material.textfield.TextInputLayout
                                style="@style/Widget.ResQLink.TextInputLayout"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:hint="@string/hint_json_path">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/etJsonPath"
                                    style="@style/Widget.ResQLink.TextInputEditText"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="text"
                                    android:text="navigation_graph.json" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.textfield.TextInputLayout
                                style="@style/Widget.ResQLink.TextInputLayout"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:hint="@string/hint_model_path">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/etModelPath"
                                    style="@style/Widget.ResQLink.TextInputEditText"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="text"
                                    android:text="building.glb" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnLoad"
                                style="@style/Widget.ResQLink.Button.Outlined"
                                android:layout_width="wrap_content"
                                android:layout_height="40dp"
                                android:layout_marginTop="8dp"
                                android:text="@string/btn_load"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="8dp" />
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
